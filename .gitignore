# ---- Python / server ----
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.db
*.sqlite3
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# ---- Android / Gradle ----
.gradle/
local.properties
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.keystore
!debug.keystore
# The release keystore is a .jks in every instruction that produces one - the
# APK workflow writes `release.jks` - and `*.keystore` does not cover that
# name. A signing key committed once is a key that has to be replaced, because
# an app already installed can only be updated by the key that signed it.
*.jks
*.p12
keystore.properties
android/build/
android/*/build/
android/app/release/
# Kotlin compiler scratch: incremental-cache state and daemon crash logs.
android/.kotlin/

# ---- IDE ----
.idea/
*.iml
.DS_Store
.vscode/

# ---- Agent configuration ----
# Shared agent config is committed (.claude/settings.json, agents/, skills/,
# commands/); personal overrides are not.
.claude/settings.local.json
