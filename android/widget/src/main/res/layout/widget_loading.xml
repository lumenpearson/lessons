<?xml version="1.0" encoding="utf-8"?>
<!--
  initialLayout: what the launcher shows between "widget dropped" and Glance's
  first RemoteViews arriving.

  It used to be the bare surface, on the theory that the gap is about 200 ms and
  that flashing text about to be replaced is worse than nothing. The gap is not
  200 ms on a cold process: the first render opens Room and DataStore from a
  standing start, and on a phone that has just been unlocked it can be most of a
  minute. For that minute the user is looking at an empty black rectangle they
  have just dragged onto their home screen, which reads as a widget that does not
  work — the one impression it cannot afford to make on its first appearance.

  So it says what it is doing. @android:id/background is what makes the launcher
  round our corners and apply its own widget background treatment.

  The text colour is named rather than inherited, and it has to be: the theme
  below is DeviceDefault, which is the *dark* one until the DayNight variant
  arrives in API 29, while the surface under it is the light one out of
  res/values, because values-night keys off a night mode Android 8 and 9 have no
  switch for. Inheriting textColorPrimary under that pairing is white on
  #F4F1EC, and it was — for every Android 8 and 9 phone this sentence was drawn
  invisibly, which is the blank rectangle the layout exists to prevent, drawn by
  the layout itself.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:padding="12dp"
    android:theme="@style/Theme.Lessons.Widget">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0.6"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/widget_loading"
        android:textColor="@color/widget_preview_on_surface"
        android:textSize="13sp" />

</FrameLayout>
