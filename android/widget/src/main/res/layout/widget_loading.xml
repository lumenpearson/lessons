<?xml version="1.0" encoding="utf-8"?>
<!--
  initialLayout: what the launcher shows in the ~200 ms between "widget dropped"
  and Glance's first RemoteViews arriving. Deliberately just the surface, so the
  drop animation does not flash text that is about to be replaced.
  The @android:id/background id is what makes the launcher round our corners and
  apply its own widget background treatment.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:theme="@style/Theme.Lessons.Widget" />
