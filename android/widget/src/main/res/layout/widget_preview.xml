<?xml version="1.0" encoding="utf-8"?>
<!--
  previewLayout (API 31+): the launcher renders this at real scale in the widget
  picker instead of a bitmap, so it must look like the MEDIUM size class does.
  It is intentionally static — the picker never runs our code.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="14dp"
    android:theme="@style/Theme.Lessons.Widget">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_state_lesson"
        android:textColor="@color/widget_preview_accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_preview_subject"
        android:textColor="@color/widget_preview_on_surface"
        android:textSize="19sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:text="@string/widget_preview_countdown"
        android:textColor="@color/widget_preview_on_surface_variant"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_preview_bar" />
</LinearLayout>
