<?xml version="1.0" encoding="utf-8"?>
<!--
  This manifest is merged into :app, so :app declares nothing about the widget.
  Everything the headline feature needs to exist on the home screen is here.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Alarms armed with AlarmManager do not survive a reboot, and the tick alarm
      is the only thing keeping the countdown honest. Without this the widget
      would freeze at whatever it said before the phone was switched off.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Exact alarms are requested, in :app rather than here.

      An earlier version of this comment claimed the opposite. It was wrong:
      the app manifest declares SCHEDULE_EXACT_ALARM and USE_EXACT_ALARM, and
      that is the intended design. The project is distributed as an APK inside
      a school, not through Google Play, so the Play policy that reserves
      USE_EXACT_ALARM for alarm and calendar apps does not apply, and a bell
      that lands on the second is worth more here than the permission is.

      WidgetTickScheduler still checks canScheduleExactAlarms() and degrades to
      a window, because the permission can be absent on a sideloaded build or
      revoked by the user. Losing exactness must never crash the widget.
    -->

    <application>

        <!--
          exported=true is mandatory for an app-widget provider: the launcher is
          a different process and has to be able to send APPWIDGET_UPDATE.
        -->
        <receiver
            android:name="com.lumenpearson.lessons.widget.LessonsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_provider_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!--
                  CONFIGURATION_CHANGED used to be listed here, to redraw on a
                  theme flip. The platform never delivers it to a receiver
                  declared in a manifest — only to one registered through
                  Context.registerReceiver, which a widget with no running
                  process cannot do — so the filter matched nothing and the
                  branch behind it never ran. Night colours come from
                  res/values-night instead, resolved by the launcher when it
                  inflates the RemoteViews.
                -->
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lessons_widget_info" />
        </receiver>

        <!--
          The tick receiver is internal plumbing: only our own alarms and a few
          system broadcasts reach it, so it stays unexported. It is separate from
          the provider above because GlanceAppWidgetReceiver already consumes
          goAsync() for the actions it handles, and a BroadcastReceiver can only
          hand out its PendingResult once.

          The sync broadcast is handled here rather than on the provider above
          for the export: an app-widget provider has to be exported for the
          launcher to bind to it, and an exported receiver accepts the action
          from anybody, not only from :core:data. Nothing could be injected
          through it — the redraw reads the local cache and the broadcast
          carries no extras — but any app on the device could have made this one
          redraw on a loop, which on a widget means the battery. Everything this
          receiver does for a tick is what a sync needs anyway: redraw, then
          re-arm from the new state.
        -->
        <receiver
            android:name="com.lumenpearson.lessons.widget.tick.WidgetTickReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- A manual clock or timezone change invalidates every armed alarm. -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- :core:data fires this after every successful sync. -->
                <action android:name="com.lumenpearson.lessons.action.DATA_SYNCED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
