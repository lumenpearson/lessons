<?xml version="1.0" encoding="utf-8"?>
<!--
    Permissions live here rather than in :widget on purpose: a permission is a
    property of the installed application, and keeping them in one file makes the
    review before a Play upload a single-file read. The widget receiver itself is
    declared by :widget and arrives through manifest merging.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sync with the school server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- "Урок закончится через 5 минут" style notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Haptics above the lightest level are played through the vibrator rather
        than through View.performHapticFeedback, because the platform's feedback
        constants carry no amplitude and so cannot express a strength dial.
        Vibrator.vibrate needs this permission; performHapticFeedback does not,
        which is why the app ran for a while without it and then threw a
        SecurityException the moment somebody chose "Двойной" or "Чёткий".
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The widget re-arms its alarm chain after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        The widget flips state exactly on a bell, so it schedules one exact alarm
        per transition instead of waking up every minute.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:name=".LessonsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_classic_myata"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_classic_myata_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lessons.Starting"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|smallestScreenSize|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Lessons.Starting"
            android:windowSoftInputMode="adjustResize" />

        <!--
          The launcher icons (docs/specs/2026-10-09-app-icons-design.md). Each is
          an alias of MainActivity under its own icon, and exactly one of them is
          enabled: the app changes its icon by changing which one
          (appicon/LauncherAliases.kt), and the component state is the only record
          of the choice. MainActivity itself is never a launcher entry and never
          disabled, because the widget and the alerts start it by class name.
          Only «Классика · Мята» is enabled here, so a fresh install shows it
          before a line of code runs. AppIconCatalogTest holds this list,
          AppIconCatalog and res/ to one another, in this order.
        -->
        <activity-alias
            android:name=".launcher.classic_rassvet"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_classic_rassvet"
            android:roundIcon="@mipmap/ic_launcher_classic_rassvet_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.classic_indigo"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_classic_indigo"
            android:roundIcon="@mipmap/ic_launcher_classic_indigo_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.classic_myata"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_classic_myata"
            android:roundIcon="@mipmap/ic_launcher_classic_myata_round"
