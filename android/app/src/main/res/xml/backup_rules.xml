<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing here is worth restoring onto a new device.

  The Room cache is a copy of the server's answer and is refetched on first
  sync, and the device token is tied to a device that the user is replacing.
  Restoring either would show a stale timetable to someone who then has no idea
  why it is wrong. Re-entering the eight-character class code is cheaper.

  Crash reports are excluded for a different reason: the first run promises
  that a report stays on the phone until its owner sends it, and a backup is
  the phone sending it to Google (#156). CrashReporter writes them to
  getExternalFilesDir("crash_reports") and, when there is no external storage,
  to filesDir/crash_reports, so both domains are named. BackupRulesTest fails
  if either is left out here or in data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore" />
    <exclude domain="external" path="crash_reports" />
    <exclude domain="file" path="crash_reports" />
</full-backup-content>
