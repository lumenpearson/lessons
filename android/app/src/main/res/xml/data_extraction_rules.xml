<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ equivalent of backup_rules.xml; same reasoning, including why the
  crash reports are excluded from both the cloud and a transfer to a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
        <exclude domain="external" path="crash_reports" />
        <exclude domain="file" path="crash_reports" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
        <exclude domain="external" path="crash_reports" />
        <exclude domain="file" path="crash_reports" />
    </device-transfer>
</data-extraction-rules>
