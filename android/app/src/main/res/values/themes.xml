<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      The activity theme exists only to paint the window before Compose takes
      over. Everything visible after that comes from LessonsTheme, so this stays
      deliberately bare: a wrong colour here shows as a flash on cold start.
    -->
    <style name="Theme.Lessons" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--
      Applied in the manifest and swapped for Theme.Lessons in onCreate.

      Empty below API 31, where the splash-screen attributes do not exist: the
      window simply opens on the background colour it inherits, which is what
      those phones did before the platform had a splash screen at all. The
      variant that fills it in lives in values-v31.
    -->
    <style name="Theme.Lessons.Starting" parent="Theme.Lessons" />

</resources>
