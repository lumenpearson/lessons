<?xml version="1.0" encoding="utf-8"?>
<!--
    The words of the notifications, in the module that posts them.

    They are here and not in :app because the poster is a broadcast receiver in
    this module: it fires while the app is not running, has no Compose tree to
    read a string from, and must not pull a UI module in to find one.
-->
<resources>

    <!-- Channels -->
    <string name="alert_channel_lessons">Уроки</string>
    <string name="alert_channel_lessons_description">Напоминание за несколько минут до начала урока.</string>
    <string name="alert_channel_daily">Расписание на день</string>
    <string name="alert_channel_daily_description">Утренняя сводка и вечернее напоминание о домашнем задании.</string>
    <string name="alert_channel_changes">Изменения</string>
    <string name="alert_channel_changes_description">Замены и отмены, которые пришли с сервера школы.</string>

    <!-- A lesson is coming -->
    <plurals name="alert_lesson_title">
        <item quantity="one">Через %1$d минуту</item>
        <item quantity="few">Через %1$d минуты</item>
        <item quantity="many">Через %1$d минут</item>
        <item quantity="other">Через %1$d минуты</item>
    </plurals>
    <string name="alert_lesson_room">%1$s, кабинет %2$s</string>
    <string name="alert_lesson_teacher">%1$s, %2$s</string>
    <string name="alert_lesson_replaced">%1$s (замена)</string>

    <!-- The sample notification: what a reminder looks like with the current settings -->
    <string name="alert_sample_subject">Алгебра</string>
    <string name="alert_sample_room">214</string>
    <string name="alert_sample_teacher">Иванова М. П.</string>

    <!-- The morning digest -->
    <plurals name="alert_morning_title">
        <item quantity="one">Сегодня %1$d урок</item>
        <item quantity="few">Сегодня %1$d урока</item>
        <item quantity="many">Сегодня %1$d уроков</item>
        <item quantity="other">Сегодня %1$d урока</item>
    </plurals>
    <string name="alert_morning_body">Первый — %1$s в %2$s. Последний заканчивается в %3$s.</string>

    <!-- Homework -->
    <plurals name="alert_homework_title">
        <item quantity="one">На завтра задано по %1$d предмету</item>
        <item quantity="few">На завтра задано по %1$d предметам</item>
        <item quantity="many">На завтра задано по %1$d предметам</item>
        <item quantity="other">На завтра задано по %1$d предметам</item>
    </plurals>

    <!-- Changes to the timetable -->
    <string name="alert_changes_title">Расписание изменилось</string>
    <string name="alert_changes_body">Ближайшие дни обновились: проверьте замены и отмены.</string>

</resources>
