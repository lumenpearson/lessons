<?xml version="1.0" encoding="utf-8"?>
<!--
  The data layer contributes exactly two permissions and nothing else. The
  DATA_SYNCED broadcast is deliberately NOT declared here: it is an explicit,
  package-internal intent, and the receiver is registered by :widget so that
  :core:data never has to know that a widget exists.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
