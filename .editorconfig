# No file in this repository contains a tab or trailing whitespace, and every
# one ends with a newline. This file introduces no new rule: it records what is
# already true, so that an editor does not break it with its first edit.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Kotlin: kotlin.code.style=official in android/gradle.properties — four spaces
# and a hundred and twenty columns. Four lines in the whole tree are longer, and
# all four are links inside comments, with nowhere to wrap them.
[*.{kt,kts}]
max_line_length = 120

# Python: line-length = 100 in server/pyproject.toml, which is what ruff checks.
[*.py]
max_line_length = 100

# Android resources and manifests: four spaces, as in values/strings.xml.
[*.xml]
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{properties,cfg,ini}]
indent_size = 4

# Markdown: prose wraps at around eighty columns, but tables and links run
# longer and there is nothing to cut them with. No document here uses trailing
# whitespace as a line break, so it is safe to strip.
[*.md]
max_line_length = off

# gradlew.bat is stored with CRLF, because cmd.exe parses it wrongly otherwise.
# The rest of the tree is LF.
[*.bat]
end_of_line = crlf

# The Gradle wrapper comes from the distribution and changes only when it is
# updated.
[**/gradle/wrapper/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
