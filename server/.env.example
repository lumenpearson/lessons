# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Telegram user ids with permanent OWNER rights, comma separated, on ONE line:
#     OWNER_IDS=111111111,222222222,333333333
# Find yours by writing to @userinfobot.
#
# Only a comma (or a semicolon) separates. Spaces around the numbers are fine
# and a trailing comma is fine, but a space or a newline between ids is not a
# separator and reads as nothing at all - which matters because Vercel's value
# field is a textarea that invites one id per line. Anything that is not a
# number is dropped without a word, so a typo in one id costs that person their
# rights while the rest keep theirs. See Settings.owner_id_list in app/config.py.
OWNER_IDS=123456789

# Database. SQLite by default, Postgres for production:
# DATABASE_URL=postgresql+asyncpg://lessons:lessons@db:5432/lessons
DATABASE_URL=sqlite+aiosqlite:///./lessons.db

# Default timezone for NEW classes (IANA name). Each class stores its own zone,
# picked in the bot when the class is created - Russia spans eleven of them, so
# this value is only a starting point, not a server-wide setting.
TIMEZONE=Europe/Moscow

# HTTP
HOST=0.0.0.0
PORT=8000

# Set to false to run the API without starting the Telegram bot (useful in tests/CI)
RUN_BOT=true

# Public origin of this deployment, for the calendar feed and the diary
# sign-in page. Configured rather than read off a request: behind Vercel the
# function sees an internal host, and the bot builds URLs from inside a
# Telegram update where there is no request at all.
# PUBLIC_BASE_URL=https://lessons.example.com

# Key for the electronic diary's stored session (app/crypto.py). The upstream's
# token is replayed on every call, so it cannot be a hash like everything else
# here - it is encrypted instead, and this is the key.
#
# Empty disables the diary outright rather than falling back to plaintext.
# Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Where it belongs: the environment of whatever runs the app - on Vercel, the
# project's environment variables. NOT a GitHub Actions secret: no workflow
# imports this code (the tests set their own in tests/conftest.py, and
# reminders.yml only calls the deployed tick over HTTP).
#
# Keep it identical across Vercel environments that share one database, or a
# session opened against Preview will not open against Production. Nothing
# breaks - an unreadable session is treated as expired - but it looks like one.
# DIARY_SECRET=
