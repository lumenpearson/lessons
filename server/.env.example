# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Telegram user ids with permanent OWNER rights, comma separated.
# Find yours by writing to @userinfobot.
OWNER_IDS=123456789

# Database. SQLite by default, Postgres for production:
# DATABASE_URL=postgresql+asyncpg://lessons:lessons@db:5432/lessons
DATABASE_URL=sqlite+aiosqlite:///./lessons.db

# Default timezone for NEW classes (IANA name). Each class stores its own zone,
# picked in the bot when the class is created - Russia spans eleven of them, so
# this value is only a starting point, not a server-wide setting.
TIMEZONE=Europe/Moscow

# HTTP
HOST=0.0.0.0
PORT=8000

# Set to false to run the API without starting the Telegram bot (useful in tests/CI)
RUN_BOT=true
