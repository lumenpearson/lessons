# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Telegram user ids with permanent OWNER rights, comma separated, on ONE line:
#     OWNER_IDS=111111111,222222222,333333333
# Find yours by writing to @userinfobot.
#
# Only a comma (or a semicolon) separates. Spaces around the numbers are fine
# and a trailing comma is fine, but a space or a newline between ids is not a
# separator and reads as nothing at all - which matters because Vercel's value
# field is a textarea that invites one id per line. Anything that is not a
# number is dropped without a word, so a typo in one id costs that person their
# rights while the rest keep theirs. See Settings.owner_id_list in app/config.py.
OWNER_IDS=123456789

# Database. SQLite by default, Postgres for production.
#
# The default below is a local convenience and nothing else: a deployment has
# no disk to keep that file on, and `aiosqlite` is deliberately absent from
# requirements.txt. Leaving it in place on a deployment used to die inside
# SQLAlchemy with `ModuleNotFoundError: No module named 'aiosqlite'`, naming
# neither this setting nor this project; a deployment now refuses to start and
# says which variables are missing. See docs/deploy.md.
# DATABASE_URL=postgresql+asyncpg://lessons:lessons@db:5432/lessons
DATABASE_URL=sqlite+aiosqlite:///./lessons.db

# Default timezone for NEW classes (IANA name). Each class stores its own zone,
# picked in the bot when the class is created - Russia spans eleven of them, so
# this value is only a starting point, not a server-wide setting.
TIMEZONE=Europe/Moscow

# HTTP
HOST=0.0.0.0
PORT=8000

# Set to false to run the API without starting the Telegram bot (useful in tests/CI)
#
# On a serverless deployment this MUST be false, and a deployment refuses to
# start otherwise. Long polling cannot outlive a response there, and Telegram
# hands its updates to one consumer: a loop started on a cold start takes them
# away from the webhook that is supposed to receive them.
RUN_BOT=true

# How many reverse proxies sit in front of this app.
#
# Zero, the default, means none - and then forwarding headers are ignored
# entirely. X-Forwarded-For is client-supplied text: believing it lets any
# caller pick their own rate-limit bucket and rotate out of it on every
# request, which is the limit not existing at all. Set it to the real number
# of proxies and the entry that many places from the right is used instead.
# Vercel needs none of this: it writes its own header and replaces whatever
# the client sent.
# TRUSTED_PROXY_HOPS=0

# Shared secret for the Telegram webhook, which is how the bot receives
# updates wherever polling cannot run. Telegram repeats it back in the
# X-Telegram-Bot-Api-Secret-Token header and the endpoint refuses anything
# else.
#
# MANDATORY on a deployment, and not because of tidiness: an unauthenticated
# webhook is a URL anybody can POST a forged update to, from any user id,
# including an owner's. Empty and the webhook is simply not registered - the
# bot then looks like it is ignoring everyone, with nothing anywhere saying
# why. Locally it is unused: RUN_BOT=true polls instead.
#
# Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# WEBHOOK_SECRET=

# Where that webhook listens. Change it only if something else already answers
# on this path; whatever it says has to match the URL registered with
# Telegram, and docs/deploy.md registers the one below.
# WEBHOOK_PATH=/api/v1/telegram/webhook

# Shared secret for the reminder tick, in the X-Cron-Secret header.
#
# This deployment has no clock: nothing runs between requests, so the morning
# and evening digests are driven from outside by whoever calls
# GET /api/v1/cron/tick every few minutes. Empty means that endpoint refuses
# everyone, which is the safe default - a tick anybody can trigger is a way to
# make the bot message every subscriber on demand.
#
# Empty locally is fine: nothing is due on a demo class, and the tick can be
# called by hand when you want to see a digest.
# CRON_SECRET=

# Public origin of this deployment, for the calendar feed and the diary
# sign-in page. Configured rather than read off a request: behind Vercel the
# function sees an internal host, and the bot builds URLs from inside a
# Telegram update where there is no request at all.
# PUBLIC_BASE_URL=https://lessons.example.com

# The bot's @username without the "@", for the t.me/<bot>?start=link_<code>
# deep link behind «📱 Подключить телефон». Not fetched from Telegram at
# runtime: that is one API round trip per cold start for a value that never
# changes. Empty and the button falls back to asking the reader to type the
# code, which works and is worse.
# BOT_USERNAME=

# Key for the electronic diary's stored session (app/crypto.py). The upstream's
# token is replayed on every call, so it cannot be a hash like everything else
# here - it is encrypted instead, and this is the key.
#
# Empty disables the diary outright rather than falling back to plaintext.
# Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Where it belongs: the environment of whatever runs the app - on Vercel, the
# project's environment variables. NOT a GitHub Actions secret: no workflow
# imports this code (the tests set their own in tests/conftest.py, and
# reminders.yml only calls the deployed tick over HTTP).
#
# Keep it identical across Vercel environments that share one database, or a
# session opened against Preview will not open against Production. Nothing
# breaks - an unreadable session is treated as expired - but it looks like one.
# DIARY_SECRET=

# Key for the school directory (DaData), which searches ЕГРЮЛ — the register of
# legal entities, and the only place every Russian school actually is, because
# every school is one. There is no official nationwide directory to ship with
# the project: Рособрнадзор's open-data endpoints answer 404.
#
# Empty disables the search and leaves manual entry. Nothing falls back to a
# bundled list: a snapshot would answer confidently with last year's schools
# and nothing on the screen would say which of the two you were looking at.
#
# Free tier is 10 000 requests a day, which is one search per keystroke-free
# query — the bot searches once and pages the answer locally.
# Get one at https://dadata.ru/profile/#info (the "API-ключ", not the secret).
#
# Where it belongs: the environment of whatever runs the app - on Vercel, the
# project's environment variables. Never in the repository and never in the
# APK: the phone asks this server, and the key stays on the server.
# DADATA_TOKEN=

# The oldest app this server still answers over v2, as the APK's versionCode,
# which every v2 request carries in its X-Lessons-Client header. Empty or 0 is
# no minimum. With one set, an app that says it is older is refused with
# CLIENT_TOO_OLD and asks to be updated; a request that says nothing is never
# refused. Raise it only after the newer APK is on the phones it would refuse.
# MIN_CLIENT_VERSION=

# --- A proxy for the Petersburg diary (optional) -------------------------------
#
# dnevnik2.petersburgedu.ru drops connections from outside Russia, so a server
# abroad - Vercel - cannot reach it directly (#235). Set this to an HTTP proxy
# on a Russian machine and the Petersburg diary's requests, and only those, go
# through it as a CONNECT tunnel: TLS stays end to end, so the proxy sees the
# host name and never the family's credential (#334). The bot, Telegram, the
# database and the other diaries go direct as before - Telegram is blocked from
# Russian data centres, which is why the whole server does not move there.
#
# http://user:password@host:port. It can carry a password, so it is a secret
# like the others: the environment of whatever runs the app, never the
# repository, and never echoed in a log. Empty means direct.
# DIARY_PROXY_URL=

# A fine-grained GitHub token with read-only access to public repositories and
# no other permission, for the self-check's read of this repository's `main`
# (services/health.py). With it, an unchanged `main` costs nothing against
# GitHub's rate limit and the ceiling is 5,000 requests an hour instead of the
# sixty shared by every anonymous caller on Vercel's egress address. Empty
# means GitHub is asked anonymously, which the check reads as merely unknown
# rather than down.
#
# Not GITHUB_TOKEN: GitHub Actions and plenty of tools reserve that name for a
# token with write access, and this one must never be that.
# GITHUB_READ_TOKEN=

# --- Error tracking (optional) -----------------------------------------------
#
# The DSN of a Sentry project: sentry.io, data region EU, platform Python /
# FastAPI. Set, each unhandled error is sent with its type and its place -
# file, function, line - the route template, the commit and the environment,
# and 5 % of requests are timed by route. Never a body, a header, a cookie, a
# query string, an exception's message, a local variable or a log line
# (app/observability.py). Empty sends nothing and imports nothing of Sentry;
# the startup log says it is off.
#
# It names a project anybody could send events to, so it is a secret like the
# others: the environment of whatever runs the app, never the repository.
# SENTRY_DSN=

# One variable is deliberately NOT here: VERCEL. The platform sets it about
# itself, and it is what switches on the check that refuses to start when a
# deployment is missing something. Setting it by hand on a machine that is not
# a deployment makes that machine refuse to start too - which is exactly the
# accident the check is written to avoid causing. Nor are VERCEL_ENV,
# VERCEL_GIT_COMMIT_SHA, VERCEL_GIT_REPO_OWNER, VERCEL_GIT_REPO_SLUG and
# VERCEL_REGION: Vercel states them about the running deployment, and the
# server reads them from its environment alone (app/config.py, deployment()).
