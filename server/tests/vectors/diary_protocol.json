 "version": 1,
 "about": "Known answers for the two diary sign-in protocols, read by the server's tests/test_diary_protocol_vectors.py and the phone's DiaryProtocolVectorsTest. The file is the oracle, not either codebase: a change here is a change to both implementations. Bodies are compared as decoded values, never as bytes (OkHttp and httpx encode the same form differently).",
 "user_agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
 "session": {"idle_days": 30},
 "petersburg": {
  "origin": "https://dnevnik2.petersburgedu.ru",
  "login_path": "/api/user/auth/login",
  "session_cookie": "X-JWT-Token",
  "login_fields": {"type": "email", "activation_code": null, "_isEmpty": false},
  "login_cases": [
   {"name": "cookie wins over body", "status": 200, "content_type": "application/json", "body": "{\"data\":{\"token\":\"body\"}}", "set_cookie": ["X-JWT-Token=cookie; Path=/"], "expect": {"token": "cookie"}},
   {"name": "two paths, last wins", "status": 200, "content_type": "application/json", "body": "{\"data\":{\"token\":\"body\"}}", "set_cookie": ["X-JWT-Token=old; Path=/", "X-JWT-Token=new; Path=/api"], "expect": {"token": "new"}},
   {"name": "deletion is not a session", "status": 200, "content_type": "application/json", "body": "{\"data\":{\"token\":\"body\"}}", "set_cookie": ["X-JWT-Token=; Max-Age=0; Path=/"], "expect": {"token": "body"}},
   {"name": "an expired cookie is not a session", "status": 200, "content_type": "application/json", "body": "{\"data\":{\"token\":\"body\"}}", "set_cookie": ["X-JWT-Token=gone; Max-Age=0; Path=/"], "expect": {"token": "body"}},
   {"name": "body token is trimmed", "status": 200, "content_type": "application/json", "body": "{\"data\":{\"token\":\"  body  \"}}", "set_cookie": [], "expect": {"token": "body"}},
   {"name": "html 200", "status": 200, "content_type": "text/html", "body": "<html>", "set_cookie": [], "expect": {"failure": "unexpected"}},
   {"name": "json that is not an object", "status": 200, "content_type": "application/json", "body": "[1]", "set_cookie": [], "expect": {"failure": "unexpected"}},
   {"name": "data null with a message", "status": 200, "content_type": "application/json", "body": "{\"data\":null,\"message\":\"Ошибка\"}", "set_cookie": [], "expect": {"failure": "unexpected"}},
   {"name": "400", "status": 400, "content_type": "application/json", "body": "{}", "set_cookie": [], "expect": {"failure": "bad_credentials"}},
   {"name": "401", "status": 401, "content_type": "application/json", "body": "{}", "set_cookie": [], "expect": {"failure": "bad_credentials"}},
   {"name": "403", "status": 403, "content_type": "application/json", "body": "{}", "set_cookie": [], "expect": {"failure": "bad_credentials"}},
   {"name": "500", "status": 500, "content_type": "application/json", "body": "{}", "set_cookie": [], "expect": {"failure": "unavailable"}},
   {"name": "502", "status": 502, "content_type": "text/html", "body": "<html>", "set_cookie": [], "expect": {"failure": "unavailable"}},
   {"name": "no token", "status": 200, "content_type": "application/json", "body": "{\"data\":{}}", "set_cookie": [], "expect": {"failure": "unexpected"}}
  ]
 },
